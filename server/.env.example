NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/nile
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-another-32-random-characters
TRANSCRIPT_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:4175
# Production: .saerbridge.com, and API must be api.saerbridge.com
COOKIE_DOMAIN=
ADMIN_EMAILS=
RESEND_API_KEY=
EMAIL_FROM=
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
AI_MONTHLY_TOKEN_BUDGET=1000000
AI_GLOBAL_MONTHLY_TOKEN_BUDGET=5000000
LEGACY_AI_ENABLED=false
ENABLE_TEST_AUTH=false
NILE_DEMO_SEED=false
INFORMATION_OFFICER_EMAIL=we@saerbridge.com
# Populate verified legal facts before launch. Never invent registration/address details.
COMPANY_REGISTRATION_NUMBER=
INFORMATION_OFFICER_NAME=
REGISTERED_ADDRESS=

# Optional shared-container pilot worker and hourly maintenance
NILE_BACKGROUND_ENABLED=false
NILE_RUN_WORKER=false
